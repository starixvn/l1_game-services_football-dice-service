{
    "name": "football-dice-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/l1/game-services/football-dice-service.git"
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "scripts": {
        "dev-test": "jest",
        "test": "jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "integration-test": "jest --testPathPattern=tests/integration-tests",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "stats": "nodemon --es-module-specifier-resolution=node --watch ./tests ./tests/rtp/index.js",
        "reg": "npm set registry http://npm.lumigame.com"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "sc-game-base": "5.0.1-beta.12"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@types/jest": "^26.0.20",
        "babel-jest": "^26.6.3",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^29.0.0",
        "jest-auto-fixture": "^1.0.6",
        "jest-extended": "^3.0.0",
        "jest-micro-auto-stub": "^1.0.8",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^2.0.4",
        "sc-game-service-integration-utils": "2.0.0"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
